<Window x:Class="DefectListWpfControl.DefectList.Views.SketchViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Эскиз"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ctrl+колесо = зум, обычное колесо = вертикальная прокрутка -->
        <ScrollViewer x:Name="ImageScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="10 10 10 0"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Image x:Name="SketchImage"
                   Stretch="None"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>

        <!-- Панель управления масштабом -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="−"
                    Margin="0 0 4 0"
                    Click="ZoomOut_Click"
                    Style="{StaticResource SecondaryButton}" />
            <TextBlock x:Name="ZoomLabel"
                       Text="100%"
                       VerticalAlignment="Center"
                       MinWidth="48"
                       TextAlignment="Center"
                       Margin="0 0 4 0" />
            <Button Content="+"
                    Margin="0 0 8 0"
                    Click="ZoomIn_Click"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="Сбросить масштаб"
                    Click="ZoomReset_Click"
                    Style="{StaticResource SecondaryButton}" />
            <TextBlock Text="  |  Ctrl + колесо мыши — масштаб"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="8 0 0 0" />
        </StackPanel>
    </Grid>
</Window>