<Window x:Class="DefectListWpfControl.DefectList.Views.MeasurementMapReadOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DefectListWpfControl.DefectList.Views"
        xmlns:viewModels="clr-namespace:DefectListWpfControl.DefectList.ViewModels"
        xmlns:components="clr-namespace:DefectListWpfControl.DefectList.Components"
        xmlns:commons="clr-namespace:DefectListWpfControl.DefectList.Commons"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="600"
        Width="600"
        d:DataContext="{d:DesignInstance d:Type=viewModels:MeasurementMapReadOnlyViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid Margin="10">
            <StackPanel VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadingStateViewModel.IsLoading}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <components:DataLoadingSpinner DataContext="Загрузка карты измерения ..." />
            </StackPanel>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadingStateViewModel.IsLoading}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Content="{Binding FormName}" />

                <DataGrid Grid.Row="1"
                          x:Name="DataGridMeasurementMapItems"
                          ItemsSource="{Binding ItemsView}"
                          IsSynchronizedWithCurrentItem="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          AutoGenerateColumns="False"
                          CopyingRowClipboardContent="DataGridMeasurementMapItems_OnCopyingRowClipboardContent"
                          SelectionUnit="FullRow"
                          BorderBrush="#ccc">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Возможный дефект"
                                                Width="*"
                                                x:Name="dataGridColumnPossibleDefectName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding PossibleDefectName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Номинальное значение"
                                                Width="160"
                                                x:Name="dataGridColumnNominalValueName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding NominalValueName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Измеренное значение"
                                                Width="160"
                                                x:Name="dataGridColumnActualValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding ActualValue}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Дата измерения"
                                            Binding="{Binding ActualValueRecordDate, StringFormat=\{0:dd.MM.yyyy\}}"
                                            Width="100"
                                            x:Name="dataGridColumnActualValueRecordDate" />
                        <DataGridTemplateColumn Header="Рекомендуемый метод ремонта"
                                                    Width="190"
                                                    x:Name="dataGridColumnActualRecommendedRepairMethod">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualRecommendedRepairMethodName}"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Отметка о выполнении работ по устранению дефекта"
                                                Width="180"
                                                x:Name="dataGridColumnMarkOfWorkCompletion">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MarkOfWorkCompletion}"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Требование после ремонта"
                                                Width="250"
                                                x:Name="dataGridColumnRequirementPostRepairName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding RequirementPostRepairName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2"
                        Content="Экспорт (excel)"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExportMapCommand}"
                        HorizontalAlignment="Left"
                        Margin="0 10" />

                <Button Grid.Row="2"
                        Content="Открыть эскиз"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenFormSketchViewCommand}"
                        HorizontalAlignment="Left"
                        Margin="100 10" />
            </Grid>
        </Grid>
    </Grid>
</Window>
