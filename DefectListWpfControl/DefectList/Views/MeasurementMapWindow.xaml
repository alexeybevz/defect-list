<Window x:Class="DefectListWpfControl.DefectList.Views.MeasurementMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DefectListWpfControl.DefectList.Views"
        xmlns:viewModels="clr-namespace:DefectListWpfControl.DefectList.ViewModels"
        xmlns:components="clr-namespace:DefectListWpfControl.DefectList.Components"
        xmlns:commons="clr-namespace:DefectListWpfControl.DefectList.Commons"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="600"
        Width="600"
        d:DataContext="{d:DesignInstance d:Type=viewModels:MeasurementMapViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid Margin="10">
            <StackPanel VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadingStateViewModel.IsLoading}"
                                         Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <components:DataLoadingSpinner DataContext="Загрузка карты измерения ..." />
            </StackPanel>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadingStateViewModel.IsLoading}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Content="{Binding FormName}" />

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal">
                    <Label Content="Заводской номер" />
                    <TextBox Text="{Binding SerialNumber}"
                             Width="300"
                             Height="22" />
                </StackPanel>

                <DataGrid Grid.Row="3"
                          x:Name="DataGridMeasurementMapItems"
                          ItemsSource="{Binding ItemsView}"
                          IsSynchronizedWithCurrentItem="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          AutoGenerateColumns="False"
                          CopyingRowClipboardContent="DataGridMeasurementMapItems_OnCopyingRowClipboardContent"
                          BeginningEdit="DataGridMeasurementMapItemLogs_OnBeginningEdit"
                          SelectionUnit="FullRow"
                          BorderBrush="#ccc"
                          PreparingCellForEdit="DataGridMeasurementMapItems_OnPreparingCellForEdit">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <EventSetter Event="GotFocus"
                                         Handler="DataGridCell_GotFocus" />
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="DataGridMeasurementMapItems_OnPreviewMouseLeftButtonDown" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№"
                                            Binding="{Binding CustomNumeration}"
                                            Width="50"
                                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Возможный дефект"
                                                Width="*"
                                                x:Name="dataGridColumnPossibleDefectName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding PossibleDefectName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Номинальное значение"
                                                Width="160"
                                                x:Name="dataGridColumnNominalValueName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding NominalValueName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Измеренное значение"
                                                Width="160"
                                                x:Name="dataGridColumnActualValue">
                            <!-- Режим просмотра: рендер с верх/низ индексами -->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding ActualValue}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!-- Режим редактирования: сырой текст, без визуализации -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox Text="{Binding ActualValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsActualValueFreeText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="24"
                                                 MaxHeight="120" />
                                        <ComboBox Text="{Binding ActualValue, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding ActualValueOptions}"
                                                  IsEditable="false"
                                                  Visibility="{Binding IsActualValueFreeText, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                  DropDownOpened="ComboBox_OnDropDownOpened"
                                                  DropDownClosed="ComboBox_OnDropDownClosed" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Рекомендуемый метод ремонта"
                                                Width="190"
                                                x:Name="dataGridColumnActualRecommendedRepairMethod">
                            <!--Режим просмотра: обычный текст-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualRecommendedRepairMethodName}"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--Режим редактирования: ComboBox с альтернативами-->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RepairMethodOptions}"
                                              SelectedValue="{Binding ActualRecommendedRepairMethodId, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="RecommendedRepairMethodId"
                                              DisplayMemberPath="RecommendedRepairMethodName"
                                              DropDownOpened="ComboBox_OnDropDownOpened"
                                              DropDownClosed="ComboBox_OnDropDownClosed" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Отметка о выполнении работ по устранению дефекта"
                                                Width="180"
                                                x:Name="dataGridColumnMarkOfWorkCompletion">
                            <!--Режим просмотра: обычный текст-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MarkOfWorkCompletion}"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <!--Режим редактирования: ComboBox с альтернативами-->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding MarkOfWorkCompletionOptions}"
                                              SelectedValue="{Binding MarkOfWorkCompletion, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="ComboBox_OnDropDownOpened"
                                              DropDownClosed="ComboBox_OnDropDownClosed" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Требование после ремонта"
                                                Width="250"
                                                x:Name="dataGridColumnRequirementPostRepairName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock commons:EngineeringTextBehavior.Text="{Binding RequirementPostRepairName}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="4 0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="4"
                        Content="Сохранить изменения"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveItemsCommand}"
                        HorizontalAlignment="Left"
                        Margin="0 10" />
                <Button Grid.Row="5"
                        Content="Экспорт (excel)"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExportMapCommand}"
                        HorizontalAlignment="Left"
                        Margin="0 10" />

                <Button Grid.Row="5"
                        Content="Открыть эскиз"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenFormSketchViewCommand}"
                        HorizontalAlignment="Left"
                        Margin="100 10" />

                <Grid Grid.Row="6">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadingStateViewModel.HasErrorMessage}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBlock Text="{Binding LoadingStateViewModel.ErrorMessage}"
                               Style="{StaticResource ErrorMessage}"
                               TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
