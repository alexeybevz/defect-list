<Window x:Class="DefectListWpfControl.DefectList.Views.MeasurementMapDictionaryItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DefectListWpfControl.DefectList.ViewModels"
        xmlns:commons="clr-namespace:DefectListWpfControl.DefectList.Commons"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="600"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        d:DataContext="{d:DesignInstance d:Type=viewModels:MeasurementMapDictionaryItemsViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ошибка / загрузка -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0 0 0 6">
            <TextBlock Text="Загрузка..."
                       Visibility="{Binding LoadingStateViewModel.IsLoading,
                           Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="Gray"
                       FontStyle="Italic" />
            <TextBlock Text="{Binding LoadingStateViewModel.ErrorMessage}"
                       Visibility="{Binding LoadingStateViewModel.HasErrorMessage,
                           Converter={StaticResource BooleanToVisibilityConverter}}"
                       Style="{StaticResource ErrorMessage}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Кнопки управления строками -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0 0 0 8">
            <Button Content="+ Добавить строку"
                    Command="{Binding CreateItemCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14 5"
                    Margin="0 0 8 0" />
            <Button Content="Редактировать"
                    Command="{Binding EditItemCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14 5"
                    Margin="0 0 8 0" />
            <Button Content="Удалить"
                    Command="{Binding DeleteItemCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14 5" />
        </StackPanel>

        <!-- Таблица строк справочника -->
        <DataGrid Grid.Row="2"
                  x:Name="DataGridItems"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  BorderBrush="#ccc"
                  HorizontalScrollBarVisibility="Auto"
                  MouseDoubleClick="DataGridItems_OnMouseDoubleClick"
                  CopyingRowClipboardContent="DataGridItems_OnCopyingRowClipboardContent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding CustomNumeration}"
                                    Width="60" />
                <DataGridTextColumn Header="Порядок"
                                    Binding="{Binding SortOrder}"
                                    Width="70"
                                    x:Name="dataGridColumnSortOrder"/>
                <DataGridTemplateColumn Header="Возможный дефект"
                                        Width="220"
                                        x:Name="dataGridColumnPossibleDefectName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock commons:EngineeringTextBehavior.Text="{Binding PossibleDefectName}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4 2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Номинальное знач."
                                        Width="140"
                                        x:Name="dataGridColumnNominalValueName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock commons:EngineeringTextBehavior.Text="{Binding NominalValueName}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4 2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Альтерн. номинальное знач."
                                        Width="200"
                                        x:Name="dataGridColumnAlternateNominalValueName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock commons:EngineeringTextBehavior.Text="{Binding AlternateNominalValueName}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4 2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Метод ремонта"
                                    Binding="{Binding RecommendedRepairMethodName}"
                                    Width="130"
                                    x:Name="dataGridColumnRecommendedRepairMethod"/>
                <DataGridTextColumn Header="Альтернативные методы ремонта"
                                    Binding="{Binding RepairMethodAlternativesDisplay}"
                                    Width="200"
                                    x:Name="dataGridColumnAlternateRecommendedRepairMethod"/>
                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding ItemTypeName}"
                                    Width="120" />
                <DataGridTextColumn Header="Требование после ремонта"
                                    Binding="{Binding RequirementPostRepairName}"
                                    Width="220"
                                    x:Name="dataGridColumnRequirementPostRepairName"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Подпись внизу -->
        <TextBlock Grid.Row="3"
                   Text="Двойной клик по строке — редактирование. Порядок отображения определяется полем «Порядок»."
                   Foreground="Gray"
                   FontStyle="Italic"
                   FontSize="11"
                   Margin="0 6 0 0" />
    </Grid>
</Window>
