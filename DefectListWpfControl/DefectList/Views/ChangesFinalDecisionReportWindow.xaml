<Window x:Class="DefectListWpfControl.DefectList.Views.ChangesFinalDecisionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DefectListWpfControl.DefectList.Views"
        xmlns:viewModels="clr-namespace:DefectListWpfControl.DefectList.ViewModels"
        xmlns:components="clr-namespace:DefectListWpfControl.DefectList.Components"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Журнал изменения окончательного решения"
        Height="220"
        Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance d:Type=viewModels:ChangesFinalDecisionReportViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Период" />

        <Grid Grid.Row="0"
              Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0"
                        Padding="2 0 0 0"
                        Height="27"
                        FirstDayOfWeek="Monday"
                        Loaded="DatePicker_Loaded"
                        IsEnabled="{Binding IsEnabledStartDatePicker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                        SelectedDate="{Binding StartDate, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}" />
            <TextBlock Grid.Column="1"
                       Text="-"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <DatePicker Grid.Column="2"
                        Padding="2 0 0 0"
                        Height="27"
                        FirstDayOfWeek="Monday"
                        Loaded="DatePicker_Loaded"
                        IsEnabled="{Binding IsEnabledEndDatePicker, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                        SelectedDate="{Binding EndDate, Mode=TwoWay, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}" />
        </Grid>

        <Label Grid.Row="2"
               Grid.Column="0"
               Content="Тип ДСЕ" />

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Width="100"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding DetalTypOptions}"
                  SelectedValue="{Binding SelectedDetalTyp}" />

        <Button Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="Сформировать отчет"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding CreateReportCommand}" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <fa:ImageAwesome Style="{StaticResource DataLoadingSpinner}"
                             Height="14"
                             Width="14" />
            <TextBlock Text="{Binding ExecutingStatus}"
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0 3 0 0"/>
        </StackPanel>
    </Grid>
</Window>
